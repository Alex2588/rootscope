# Application
ROOTSCOPE_ENV=local

# Postgres (used by docker-compose to configure the db service; the app's own
# DATABASE_URL is derived from these inside docker-compose.yml)
POSTGRES_USER=rootscope
POSTGRES_PASSWORD=rootscope
POSTGRES_DB=rootscope

# Qdrant (default local REST endpoint; set by docker-compose.yml when run via compose)
QDRANT_URL=http://localhost:6333
